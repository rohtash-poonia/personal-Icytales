MONGO_URI=mongodb://127.0.0.1:27017/icytales?replicaSet=rs0
# Optional comma-separated DNS resolvers for mongodb+srv when the system resolver blocks SRV queries.
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
CLIENT_ORIGINS=http://localhost:3000
COOKIE_SAME_SITE=lax
TRUST_PROXY=0
NODE_ENV=development
PORT=5000
STORE_CURRENCY=USD
ORDER_SHIPPING_PRICE=20.00
# Configure all three values together to enable product image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
